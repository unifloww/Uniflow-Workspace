rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read, write: if isOwner(userId);
    }

    match /admins/{adminId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /campaigns/{campaignId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || 
                    (
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['periodClicks', 'totalClicks', 'dailyClicks', 'adminStats', 'deviceStats', 'hourlyStats', 'locationStats'])
                    );
      allow delete: if isOwner(resource.data.userId);
    }

    match /leads/{leadId} {
      allow create: if true;
      allow read, update, delete: if isOwner(resource.data.userId);
    }

    match /walinks/{linkId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']);
      allow delete: if isOwner(resource.data.userId);
    }

    match /smartlinks/{linkId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks']);
      allow delete: if isOwner(resource.data.userId);
    }

    match /biolinks/{linkId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update: if isOwner(resource.data.userId) || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['clicks', 'views', 'blocks']);
      allow delete: if isOwner(resource.data.userId);
    }

    match /products/{productId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.userId);
    }
    
    match /orders/{orderId} {
      allow read: if true; 
      allow create: if true;
      allow update, delete: if isOwner(resource.data.userId);
    }

    match /pageBlocks/{blockId} {
      allow read: if true;
      allow create: if request.auth != null && request.resource.data.creatorId == request.auth.uid;
      allow update, delete: if isOwner(resource.data.creatorId);
    }
  }
}
